# API keys for the hosted-model generation scripts (generation/generate_*.py).
#
# Copy this file to secrets.env (gitignored) and fill in the keys you need.
# generation/common.py exports these into the environment on import; variables
# already set in the environment take precedence over this file.
#
# Local/open models need no key: canary, cohere, whisper_large_v3,
# crisperwhisper_1, crisperwhisper_2.

ASSEMBLYAI_API_KEY=
CARTESIA_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
FISH_AUDIO_API_KEY=
GRADIUM_API_KEY=
INWORLD_API_KEY=
MAI_TRANSCRIBE_15_KEY=
# MAI_TRANSCRIBE_15_ENDPOINT=   # optional; defaults to the script's endpoint
XAI_API_KEY=

# Only needed for private Hugging Face repos (e.g. pro CrisperWhisper models).
# HF_TOKEN=
